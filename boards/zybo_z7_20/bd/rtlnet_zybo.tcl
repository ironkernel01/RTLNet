# Clocks and resets. clk_wiz_0: 50 MHz control (clk_out1) and 200 MHz delay reference of the D-PHY inputs (clk_out2).
create_bd_cell -type ip -vlnv {xilinx.com:ip:proc_sys_reset:5.0} rst_clk_wiz_0_50M
create_bd_cell -type ip -vlnv {xilinx.com:ip:clk_wiz:6.0} clk_wiz_0
set_property -dict [list \
  CONFIG.CLKOUT1_DRIVES {BUFG} \
  CONFIG.CLKOUT1_REQUESTED_OUT_FREQ {50} \
  CONFIG.CLKOUT2_DRIVES {BUFG} \
  CONFIG.CLKOUT2_REQUESTED_OUT_FREQ {200} \
  CONFIG.CLKOUT2_USED {true} \
  CONFIG.CLK_OUT2_PORT {clk_out2} \
  CONFIG.NUM_OUT_CLKS {2} \
  CONFIG.PRIM_SOURCE {Global_buffer} \
  CONFIG.PRIM_IN_FREQ {100} \
  CONFIG.RESET_PORT {reset} \
  CONFIG.RESET_TYPE {ACTIVE_HIGH} \
  CONFIG.USE_PHASE_ALIGNMENT {false} \
  CONFIG.USE_RESET {false} \
] [get_bd_cells clk_wiz_0]
# One 90 MHz clock for the whole video path (receiver video side, capture, HP ports, encoder).
create_bd_cell -type ip -vlnv xilinx.com:ip:clk_wiz:6.0 rtlnet_video_clock
set_property -dict [list CONFIG.PRIM_SOURCE Global_buffer CONFIG.PRIM_IN_FREQ 100 \
  CONFIG.CLKOUT1_REQUESTED_OUT_FREQ 90 CONFIG.USE_RESET false] [get_bd_cells rtlnet_video_clock]
create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 rtlnet_rst_video
create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 rtlnet_rst_encoder
# GP0 interconnect: one master, the video wrapper.
create_bd_cell -type ip -vlnv {xilinx.com:ip:axi_interconnect:2.1} ps7_0_axi_periph
set_property -dict [list CONFIG.NUM_MI {1} CONFIG.NUM_SI {1}] [get_bd_cells ps7_0_axi_periph]
create_bd_cell -type module -reference rtlnet_zybo_video_bd u_video
set_property -dict [list CONFIG.HIGH_PROFILE $::rtlnet_hp CONFIG.HP_T8 $::rtlnet_hp_t8 \
  CONFIG.HP_T8_AUTO $::rtlnet_hp_auto] [get_bd_cells u_video]
connect_bd_intf_net [get_bd_intf_ports DDR] [get_bd_intf_pins processing_system7_0/DDR]
connect_bd_intf_net [get_bd_intf_ports FIXED_IO] [get_bd_intf_pins processing_system7_0/FIXED_IO]
connect_bd_intf_net [get_bd_intf_ports cam_gpio] [get_bd_intf_pins processing_system7_0/GPIO_0]
connect_bd_intf_net [get_bd_intf_ports cam_iic] [get_bd_intf_pins processing_system7_0/IIC_0]
connect_bd_intf_net [get_bd_intf_pins processing_system7_0/M_AXI_GP0] [get_bd_intf_pins ps7_0_axi_periph/S00_AXI]
connect_bd_intf_net [get_bd_intf_pins ps7_0_axi_periph/M00_AXI] [get_bd_intf_pins u_video/S_AXI]
connect_bd_intf_net [get_bd_intf_pins u_video/M_AXI_CAP] [get_bd_intf_pins processing_system7_0/S_AXI_HP2]
connect_bd_intf_net [get_bd_intf_pins u_video/M_AXI_ENC] [get_bd_intf_pins processing_system7_0/S_AXI_HP0]
# Clocks: PS FCLK0 (100 MHz) feeds both wizards; control 50 MHz, delay reference 200 MHz, video 90 MHz.
connect_bd_net [get_bd_pins processing_system7_0/FCLK_CLK0] [get_bd_pins clk_wiz_0/clk_in1] [get_bd_pins rtlnet_video_clock/clk_in1]
connect_bd_net [get_bd_pins clk_wiz_0/clk_out1] [get_bd_pins u_video/s_axi_aclk] [get_bd_pins processing_system7_0/M_AXI_GP0_ACLK] \
  [get_bd_pins ps7_0_axi_periph/ACLK] [get_bd_pins ps7_0_axi_periph/S00_ACLK] [get_bd_pins ps7_0_axi_periph/M00_ACLK] \
  [get_bd_pins rst_clk_wiz_0_50M/slowest_sync_clk]
connect_bd_net [get_bd_pins clk_wiz_0/clk_out2] [get_bd_pins u_video/ref_clk]
connect_bd_net [get_bd_pins rtlnet_video_clock/clk_out1] [get_bd_pins u_video/capture_clk] [get_bd_pins u_video/enc_clk] \
  [get_bd_pins processing_system7_0/S_AXI_HP0_ACLK] [get_bd_pins processing_system7_0/S_AXI_HP2_ACLK] \
  [get_bd_pins rtlnet_rst_video/slowest_sync_clk] [get_bd_pins rtlnet_rst_encoder/slowest_sync_clk]
# Resets from the PS reset (active low; the polarity propagates to the controllers).
connect_bd_net [get_bd_pins clk_wiz_0/locked] [get_bd_pins rst_clk_wiz_0_50M/dcm_locked]
connect_bd_net [get_bd_pins rtlnet_video_clock/locked] [get_bd_pins rtlnet_rst_video/dcm_locked] [get_bd_pins rtlnet_rst_encoder/dcm_locked]
connect_bd_net [get_bd_pins processing_system7_0/FCLK_RESET0_N] [get_bd_pins rst_clk_wiz_0_50M/ext_reset_in] \
  [get_bd_pins rtlnet_rst_video/ext_reset_in] [get_bd_pins rtlnet_rst_encoder/ext_reset_in]
connect_bd_net [get_bd_pins rst_clk_wiz_0_50M/interconnect_aresetn] [get_bd_pins ps7_0_axi_periph/ARESETN]
connect_bd_net [get_bd_pins rst_clk_wiz_0_50M/peripheral_aresetn] [get_bd_pins ps7_0_axi_periph/S00_ARESETN] \
  [get_bd_pins ps7_0_axi_periph/M00_ARESETN] [get_bd_pins u_video/s_axi_aresetn]
connect_bd_net [get_bd_pins rtlnet_rst_video/peripheral_aresetn] [get_bd_pins u_video/capture_resetn]
connect_bd_net [get_bd_pins rtlnet_rst_encoder/peripheral_aresetn] [get_bd_pins u_video/enc_resetn]
# Camera pins.
foreach port {dphy_hs_clock_clk_p dphy_hs_clock_clk_n dphy_clk_lp_p dphy_clk_lp_n dphy_data_hs_p dphy_data_hs_n dphy_data_lp_p dphy_data_lp_n} {
  connect_bd_net [get_bd_ports $port] [get_bd_pins u_video/$port]
}
# Interrupts: capture (bit 0) and encoder (bit 1) from the two-bit irq of u_video, the other fourteen inputs tied low.
create_bd_cell -type ip -vlnv xilinx.com:ip:xlconcat:2.1 rtlnet_irqs
set_property CONFIG.NUM_PORTS 16 [get_bd_cells rtlnet_irqs]
create_bd_cell -type ip -vlnv xilinx.com:ip:xlconstant:1.1 rtlnet_irq_zero
set_property -dict [list CONFIG.CONST_VAL 0 CONFIG.CONST_WIDTH 1] [get_bd_cells rtlnet_irq_zero]
foreach lane {0 1} {
  create_bd_cell -type ip -vlnv xilinx.com:ip:xlslice:1.0 rtlnet_irq_slice_$lane
  set_property -dict [list CONFIG.DIN_WIDTH 2 CONFIG.DIN_FROM $lane CONFIG.DIN_TO $lane CONFIG.DOUT_WIDTH 1] [get_bd_cells rtlnet_irq_slice_$lane]
  connect_bd_net [get_bd_pins u_video/irq] [get_bd_pins rtlnet_irq_slice_$lane/Din]
  connect_bd_net [get_bd_pins rtlnet_irq_slice_$lane/Dout] [get_bd_pins rtlnet_irqs/In$lane]
}
for {set lane 2} {$lane < 16} {incr lane} {
  connect_bd_net [get_bd_pins rtlnet_irq_zero/dout] [get_bd_pins rtlnet_irqs/In$lane]
}
connect_bd_net [get_bd_pins rtlnet_irqs/dout] [get_bd_pins processing_system7_0/IRQ_F2P]
# Module-reference segment names are inferred by IP Integrator; discover, never guess.
set rtlnet_segs [get_bd_addr_segs -quiet -of_objects [get_bd_intf_pins u_video/S_AXI]]
puts "rtlnet_build: u_video S_AXI address segments: $rtlnet_segs"
if {[llength $rtlnet_segs] != 1} {error "expected one u_video/S_AXI address segment, found [llength $rtlnet_segs]"}
assign_bd_address -offset 0x44a00000 -range 0x00010000 $rtlnet_segs
assign_bd_address
validate_bd_design
if {[get_property CONFIG.PCW_NUM_F2P_INTR_INPUTS [get_bd_cells processing_system7_0]] != 16} {
  error "IRQ_F2P must propagate to sixteen scalar concat inputs"
}
if {[get_property CONFIG.C_EXT_RESET_HIGH [get_bd_cells rtlnet_rst_video]] != 0} {
  error "PS active-low reset polarity must propagate to the video reset controller"
}
save_bd_design
